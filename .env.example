# Tripod Wellness Backend — environment configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# Server
PORT=3000
NODE_ENV=development

# Reverse-proxy trust. 1 = single proxy (default). Use false if exposed directly,
# or a number/CIDR list matching your infrastructure. Required to keep
# rate-limiting and audit IPs correct.
TRUST_PROXY=1

# Production requirements (startup fails if missing/insecure):
#  - JWT_SECRET must be at least 32 characters
#  - UPLOAD_PUBLIC_URL must be set (public base URL for uploaded files)
#  - CLIENT_URL must be set (CORS + password-reset links)

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/aura_luxe
# Optional: override Node's DNS servers (comma-separated) when mongodb+srv://
# SRV lookups fail on machines with a broken local resolver.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=1h

# Frontend origin (CORS + password-reset links). Comma-separate for multiple.
CLIENT_URL=http://localhost:5173,https://tripod-wellness.netlify.app

# SMTP (real emails). Leave SMTP_HOST empty to fall back to dev console logging.
# Host/port/user/sender may also be set in Admin → Settings → Email & SMTP.
# The password is always read from SMTP_PASS below (never stored in MongoDB).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Tripod Wellness

# Default admin shown in the UI / used as fallback contact in emails
ADMIN_EMAIL=wellnesstripod@gmail.com

# Gemini AI Spa Assistant (leave empty for curated fallback replies)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# RAG chatbot — LLM abstraction (defaults reuse the Gemini key above)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=  (falls back to GEMINI_API_KEY when empty)

# Embeddings (Gemini gemini-embedding-001 truncated to 768 dims)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Vector retrieval (atlas = MongoDB Atlas Vector Search index
# "knowledge_vec_idx"; anything else falls back to keyword search,
# which is also the automatic path on local mongod without search nodes)
VECTOR_DB_PROVIDER=atlas
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.72
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# Chat generation + streaming guards
CHAT_MAX_OUTPUT_TOKENS=500
CHAT_SSE_TIMEOUT_MS=45000

# Hourly booking-reminder job. Set false if an external worker/cron owns it.
REMINDER_SCHEDULER=true

# Public base URL used to build absolute upload file URLs
UPLOAD_PUBLIC_URL=http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE_MB=5

# Blog excerpt generation
EXCERPT_LENGTH=200

# Seeding — initial Super Admin (created only if missing)
ADMIN_SEED_EMAIL=wellnesstripod@gmail.com
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Master Director
