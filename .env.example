# Backend server
PORT=3000

# SQLite database file (resolved relative to the backend/ folder)
DB_PATH=./database/app.sqlite

# JWT
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d

# Frontend origin (comma-separated list allowed) for CORS
CLIENT_URL=http://localhost:5173

# SMTP (leave SMTP_USER empty to simulate email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=concierge@auraluxespa.in

# Gemini AI (Spa Assistant)
GEMINI_API_KEY=
